# Database Configuration
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_password
MYSQL_ROOT_PASSWORD=root_password

# Domain Configuration (for dev/prod)
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# WordPress Configuration
WORDPRESS_DEBUG=0

# WordPress Site Setup (for WP-CLI)
WP_SITEURL=localhost
WP_TITLE=WordPress Site
WP_ADMIN_USER=admin
# Leave blank to have WP-CLI generate a random password (printed once in `logs wordpress`)
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com
INSTALL_REDIS_PLUGIN=true
DEFAULT_THEME=twentytwentyfive

# Make sure these variables match the MySQL service name
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress_password 
# PHP-FPM sizing; tune to server RAM (defaults fit a ~4GB server)
#   WORDPRESS_MEM_LIMIT  ≈ RAM − OS − MySQL − other services − ~1GB headroom
#   PHP_FPM_MAX_CHILDREN ≈ WORDPRESS_MEM_LIMIT ÷ avg worker memory (docker stats ÷ workers)
WORDPRESS_MEM_LIMIT=2g
PHP_FPM_MAX_CHILDREN=20
